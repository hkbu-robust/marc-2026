# Delivered inside the content image, not tracked in git.
# simulation_app/ (platform source) and scenarios/ ship inside the content image; the platform and
# `marc.sh select` read them from there, so they are intentionally absent from this repository.
/simulation_app/
/scenarios/
/resources/
/results/
/trainer_output/
/.runtime-data/
simulation-platform/.env
**/__pycache__/
*.pyc
.pytest_cache/
*.hdf5
*.png
/demo/datasets
/demo/weights/*.pt
/demo/weights/*.onnx

# Hub snapshots baked into the agent image at docker build, not git.
/models/runtime/stage1-cctv-detector/model.pt
/models/runtime/stage2-nearfield-detector/model.pt
/models/runtime/stage1-sar-qwen/model/**
!/models/runtime/stage1-sar-qwen/model/.gitkeep
/models/runtime/graspgenx/gen/
/models/runtime/graspgenx/dis/
/models/runtime/graspgenx/grippers/
/models/runtime/graspgenx/release/
/models/runtime/openvla/*
!/models/runtime/openvla/.gitkeep
!/models/runtime/openvla/SOURCE.md
!/models/runtime/openvla/chat_template.jinja

# submission: omit these
/datasets/**
!/datasets/README.md
/checkpoints/
/runs/
/artifacts/
/experiments/
/.env
/.cache/

# Local editor / OS / runtime files
.DS_Store
.Xauthority
.vscode/

# Secrets & local runtime logs (never commit)
demo/.env
demo/tokens.env
demo/artifacts/
demo/weights/Ultralytics/

# Allow paper figures & video posters under docs/assets/
!docs/assets/**/*.png
.venv/
