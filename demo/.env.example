# Copy to demo/.env (or export in your shell) before running local practice or Docker Compose.
# Obtain a session token from your local MARC practice platform (simulation-platform/marc.sh)
# or the MARC 2026 organizers for official scoring.

MARC_TEAM_ID=robust
MARC_TOKEN=
ROS_DOMAIN_ID=0

# Loopback vLLM API key (dummy key shared between qwen and agent containers on localhost)
VLLM_API_KEY=local-vllm-key
MARC_QWEN_API_KEY=local-vllm-key

# Optional: remote vLLM endpoint when serving Qwen3-VL-8B on a separate workstation
# MARC_QWEN_BASE_URL=http://127.0.0.1:8004/v1
# MARC_QWEN_MODEL=qwen3-vl-8b
