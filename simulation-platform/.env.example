# MARC 2026 - participant platform run parameters. `cp simulation-platform/.env.example simulation-platform/.env` then edit.
# (compose auto-loads it. If unset, the defaults below are used.)

# Run scenario (public practice scenarios: marc2026_demo | marc2026_chungmu)
#   marc2026_demo = baseline walkthrough scenario (default); marc2026_chungmu = full self-scoring practice set.
ENV_MARC_SCENARIO=marc2026_demo

# Headless or not. Default false = view the GUI score panel/viewport (run `xhost +local:root` on the host first).
# Set true for a headless server with no display.
HEADLESS=false

# ROS2 DDS domain - must match the participant app (separate machine) for communication
ROS_DOMAIN_ID=0

# Your assigned team ID. The manipulation trainer (`marc.sh manip-trainer`) uses it as the robot
# ROS2 topic namespace (/marc/<team>/robot/...), so set the same value as MARC_TEAM_ID in your app.
# Not used for authentication or scoring here - it only has to match on both sides.
MARC_TEAM_ID=u1

# Auto-start. Problem selection is automatic: ./problems.yaml (mounted) is used when present —
# pose only its enabled items; delete it to pose all problems. Edit by hand or regenerate with
# `bash simulation-platform/marc.sh select <scenario>`. No env var needed to activate it.
MARC_AUTO_START=1
# These apply only when problems.yaml is absent/invalid (STAGE1=all|first|"<id>,<id>" / STAGE2=off|auto|"<id>").
MARC_AUTO_STAGE1=all
MARC_AUTO_STAGE2=auto

# dataset-gen only. Number of scenes to generate then exit (0 = interactive GUI).
# Stock image caps each run at 200; the boot patch honors this value as-is.
# TRAINER_AUTO_SCENES=4000
# Optional safety ceiling (0 = none). Set 200 to restore the stock per-run cap.
# TRAINER_AUTO_SCENES_MAX=0
# Lost-object copies per selected class (default 4-6). People stay at 1.
# TRAINER_MIN_INSTANCES=4
# TRAINER_MAX_INSTANCES=6
# Landmark copies per kept type (default 1-2). Split from objects so benches/tables
# do not bury small targets. Set both to 1 for the stock one-instance catalogue.
# TRAINER_LANDMARK_MIN_INSTANCES=1
# TRAINER_LANDMARK_MAX_INSTANCES=2
# Probability each checked non-vehicle landmark type is kept this scene.
# Default 0.35 (Qwen mix: type diversity across scenes). Set 1 to keep every type.
# TRAINER_CLASS_INCLUSION_PROBABILITY=0.35
# Cars / SUVs / taxis (police_car, normal_car_*, sports_car_*, suv, taxi):
# at most one type per scene, one copy, included on ~15% of scenes.
# TRAINER_VEHICLE_MIN_INSTANCES=1
# TRAINER_VEHICLE_MAX_INSTANCES=1
# TRAINER_VEHICLE_INCLUSION_PROBABILITY=0.15
# TRAINER_VEHICLE_MAX_TYPES=1
# Drop these lost-object types (umbrella and long_umbrella; any *umbrella* name).
# TRAINER_SKIP_CLASSES=umbrella,long_umbrella
# One of each person identity per scene (male/female/professor/student_weight),
# random pose. Set 0 for stock radio (one mesh x all poses).
# TRAINER_PEOPLE_ALL_CHARS=1
# Seat people on landmark tops (SAR: climbed on the drink machine / trash can).
# Per-person probability of on-landmark seating; of those, probability they
# sit on a non-seat (vending machine, trash can, car) instead of a bench.
# TRAINER_PEOPLE_ON_LANDMARK_PROB=0.45
# TRAINER_PEOPLE_WRONG_PLACE_PROB=0.55
# Chance to inject a vending_machine or trash_can if the scene has neither.
# TRAINER_FORCE_CLIMB_LANDMARK_PROB=0.35
# Abnormal mode: keep the usual object/landmark/people density, cycle one
# non-seat climb target per scene, co-locate one person on that cell, and
# drop posed joints onto the raycasted top so they touch it (not hover).
# TRAINER_PEOPLE_ABOVE=1
# TRAINER_PEOPLE_ABOVE_CLEARANCE=0.03
# TRAINER_PEOPLE_ABOVE_TYPES=vending_machine,trash_can,hydrant,postbox
# TRAINER_PEOPLE_ABOVE_WEIGHTS=vending_machine:3
# Fresh rendered frames after scene replacement, before capture. Raise this if
# RTX temporal ghosting remains; lower it only after checking generated PNGs.
# TRAINER_RENDER_WARMUP_FRAMES=12

# ego-dataset-gen only. Robot Base_Camera_Left YOLO set (do not mix with CCTV images).
# EGO_HEADLESS=true
# EGO_SCENES=200
# EGO_OBJECTS_MIN=1
# EGO_OBJECTS_MAX=3
# EGO_REACH_MIN=0.5
# EGO_REACH_MAX=3.5
# EGO_ROBOT_XY=4
# EGO_YAW_SPAN=360
# EGO_SKIP_CLASSES=umbrella,long_umbrella
